{
  "name": "dashboard-gerencial",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "build:update-center": "vite build --config update-system/center/vite.config.js",
    "start:update-center": "node update-system/center/server.js",
    "start:updater": "node update-system/agent/agent.js",
    "update:keys": "node scripts/generate-update-keys.js",
    "update:publish": "node scripts/publish-update.js",
    "migration:inventory": "node scripts/route-inventory.js",
    "migration:audit": "npm run migration:inventory && node scripts/express-route-audit.js",
    "start": "node server/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "bwip-js": "^4.11.4",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "mammoth": "^1.13.0",
    "multer": "^2.3.0",
    "node-firebird-driver-native": "^3.6.0",
    "nodemailer": "^10.0.3",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.3.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "proxy-addr": "^2.0.8"
  }
}
